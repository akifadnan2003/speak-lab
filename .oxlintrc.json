{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "allowExportNames": [
          "useAuth",
          "useCurrentUser",
          "homePathFor",
          "routes",
          "buttonVariants",
          "badgeVariants",
          "router"
        ]
      }
    ],
    "no-unused-vars": "error",
    "typescript/no-explicit-any": "error",
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off"
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "dev-dist",
    "playwright-report",
    "test-results"
  ],
  "settings": {
    "react": {
      "version": "19"
    }
  }
}