# Copy to `.env.local` (git-ignored). Never commit real values.
#
# ---- Supabase (M2) ----------------------------------------------------------
# Public project URL and the *anon/publishable* key only. These are safe to ship
# in the client bundle because Row Level Security protects every table.
# NEVER put the service-role key or any AI provider key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- UI preview mode (M1 only) ---------------------------------------------
# When "true", the app renders every screen with clearly-labelled demo data and
# a fake local session so the shells can be reviewed before authentication
# exists. It must be unset/false once Supabase auth ships in M2.
VITE_UI_PREVIEW=false

# ---- Build ----------------------------------------------------------------
# GitHub Pages project path. Leave unset for production; use "/" for a root
# deployment or local experiments.
# VITE_BASE_PATH=/speak-lab/
