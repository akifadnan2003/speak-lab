# Copy to `.env.local` (git-ignored). Never commit real values.
#
# ---- Supabase ---------------------------------------------------------------
# Public project URL and the *publishable* key (sb_publishable_...) or legacy anon key only.
# These are safe to ship in the client bundle because Row Level Security protects every table.
# NEVER put the secret key (sb_secret_...), the service-role key or any AI provider key here.
#
# Local stack (npx supabase start):  VITE_SUPABASE_URL=http://127.0.0.1:54321 and the
# publishable/anon key printed by `npx supabase status`.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- UI preview mode (development/tests only) --------------------------------
# When "true" AND Supabase is NOT configured, the app renders every screen with clearly-labelled
# demo data and a fake local session. The build fails if it is combined with VITE_SUPABASE_URL.
VITE_UI_PREVIEW=false

# ---- Build ----------------------------------------------------------------
# GitHub Pages project path. Leave unset for production; use "/" for a root
# deployment or local experiments.
# VITE_BASE_PATH=/speak-lab/

# ---- Edge Function secrets (set with `supabase secrets set`, never in the client) ------------
# SPEAKLAB_ALLOWED_APP_URLS=https://akifadnan2003.github.io/speak-lab/,http://localhost:5173/speak-lab/
# SPEAKLAB_INVITE_TTL_SECONDS=3600   # must match Auth > Email OTP expiration in the dashboard
